# ---------------------------------------------------------------------------
# Copia este archivo como `.env` para desarrollo local.
# En Vercel, define estas mismas variables en Settings → Environment Variables.
# ---------------------------------------------------------------------------

# URL pública del sitio (para enlaces compartidos, OAuth y metadatos OG).
# En local apunta al servidor de Vite; en Vercel se detecta sola si no la defines.
SITE_URL=http://localhost:5173

# --- Base de datos --------------------------------------------------------
# Neon Postgres (Vercel Marketplace → Neon → Connect). Usa la cadena "pooled".
# Si la dejas vacía, en local se usa SQLite (backend/patitas.db) automáticamente.
DATABASE_URL=

# Crea/verifica las tablas al arrancar. Ponlo en 0 cuando la base ya esté migrada
# para ahorrar unos milisegundos en cada arranque en frío.
AUTO_CREATE_TABLES=1

# --- Sesiones -------------------------------------------------------------
# Obligatorio en producción. Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRE_MINUTES=43200

# --- Google OAuth (opcional) ---------------------------------------------
# Google Cloud Console → Credenciales → ID de cliente OAuth (aplicación web).
# URI de redirección autorizado: https://TU-DOMINIO/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Almacenamiento de fotos ---------------------------------------------
# Vercel → Storage → Blob. Si está vacío, las fotos se guardan en backend/uploads
# (solo sirve en local: el disco de las funciones serverless es efímero).
BLOB_READ_WRITE_TOKEN=

MAX_PHOTOS=5
MAX_UPLOAD_BYTES=6291456

# --- Administradores ------------------------------------------------------
# Estos correos reciben rol de administrador al registrarse (separados por coma).
ADMIN_EMAILS=

# --- Antispam opcional (Cloudflare Turnstile) ----------------------------
# Si defines el secreto, la API exigirá captcha al publicar y al reportar.
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=

# --- CORS (solo desarrollo) ----------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
